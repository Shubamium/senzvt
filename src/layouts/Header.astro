---
import { Icon } from "astro-icon/components";
---

<header id="header" class="">
  <div class="confine">
    <div class="left">
      <button class="btn btn-main togglemenu">
        <Icon name="mdi:hamburger-menu" />
        <span>MENU</span>
      </button>
    </div>
    <div class="socials">
      <a href="https://www.tiktok.com/@senzvt" class="btn btn-headicon">
        <Icon name={"mingcute:tiktok-fill"} is:inline />
      </a>
      <a href="https://www.instagram.com/senz.vt/" class="btn btn-headicon">
        <Icon name={"mingcute:instagram-fill"} is:inline />
      </a>
      <a href="https://www.youtube.com/@SenzVT" class="btn btn-headicon">
        <Icon name={"mingcute:youtube-fill"} is:inline />
      </a>
      <a href="https://www.twitch.tv/senz" class="btn btn-headicon">
        <Icon name={"mingcute:twitch-fill"} is:inline />
      </a>
      <a href="https://x.com/SenzVT" class="btn btn-headicon">
        <Icon name={"mingcute:social-x-fill"} is:inline />
      </a>
    </div>
  </div>
</header>
<aside class="sidemenu togglemenu close">
  <img src="/bigsnowflake.png" alt="" class="decor snowflake" />
  <div class="sidehead">
    <h2>NAVIGATE</h2>
    <img src="/sidemenuarr.svg" alt="" />
  </div>
  <nav>
    <a href="#" class="btn btn-sidemenu">HOME</a>
    <a href="#about" class="btn btn-sidemenu">ABOUT</a>
    <a href="#stats" class="btn btn-sidemenu">STATS</a>
    <a href="#stream" class="btn btn-sidemenu">STREAMS</a>
    <a href="https://uwumarket.us/collections/senz" class="btn btn-sidemenu"
      >MERCH</a
    >
    <a href="#contact" class="btn btn-sidemenu">CONTACT</a>
  </nav>
  <button class="btn btn-close togglemenu">
    <span>X</span>
    <span>CLOSE</span>
  </button>
</aside>
<script>
  document.addEventListener("scroll", (e) => {
    const scrollY = window.scrollY;
    if (scrollY > 500) {
      document.getElementById("header")?.classList.add("scrolled");
    } else {
      document.getElementById("header")?.classList.remove("scrolled");
    }
  });
  document.querySelectorAll(".togglemenu").forEach((el) => {
    el.addEventListener("click", (e) => {
      e.stopPropagation();
      document.querySelector(".sidemenu")?.classList.toggle("open");
      document.querySelector(".sidemenu")?.classList.toggle("close");
    });
  });
</script>
<style lang="scss">
  .sidemenu {
    &.open {
      transform: translateX(0%);
    }

    &.close {
      transform: translateX(-100%);
    }
    .snowflake {
      position: absolute;
      right: -20%;
      width: 600px;
      height: 600px;
      top: -20%;
      z-index: -10;
      opacity: 0.1;
      animation: speen 25s infinite linear reverse;
    }
    transition: all 800ms cubic-bezier(0.165, 0.84, 0.44, 1);

    position: fixed;
    width: 40vw;
    left: 0%;
    height: 100vh;
    @media screen and (max-width: 1600px) {
      width: 50vw;
    }
    @media screen and (max-width: 1024px) {
      width: 100%;
    }
    background: rgba(255, 255, 255, 0.938);
    backdrop-filter: blur(4px);
    z-index: 1100;
    clip-path: polygon(
      0% 0%,
      100% 0%,
      100% 41%,
      91% 45%,
      100% 44%,
      100% 100%,
      0% 100%
    );

    padding: 3em;
    padding-top: 4em;
    @media screen and (max-width: 420px) {
      padding: 1em;
    }
    .sidehead {
      font-size: 2.6rem;
      color: #0360c0;
      display: flex;
      align-items: center;
      gap: 1em;
      @media screen and (max-width: 1280px) {
        font-size: 1.4rem;
      }
      h2 {
        font-weight: bolder;
        font-family: var(--fontH);
      }
      img {
        @media screen and (max-width: 550px) {
          width: 50px;
        }
      }
    }
    nav {
      display: flex;
      flex-direction: column;
      padding-bottom: 3em;
      padding-top: 1em;
      .btn-sidemenu {
        line-height: 85%;
        text-decoration: none;
        color: #012d5a;
        font-family: var(--fontH);
        font-weight: bold;
        font-size: 6rem;

        @media screen and (max-width: 1280px) {
          font-size: 4rem;
        }
        @media screen and (max-width: 550px) {
          font-size: 3rem;
        }
        &:hover {
          color: #6ebce0;
        }
        transform-origin: left;
      }
    }

    .btn-close {
      background: #0360c0;
      color: white;
      display: flex;
      font-family: var(--fontH);
      font-weight: bold;
      font-size: 2rem;
      gap: 100px;
      padding: 0.1em 0.5em;
      @media screen and (max-width: 550px) {
        gap: 20px;
        font-size: 1.4rem;
      }
    }
  }
  #header {
    position: fixed;
    top: 0%;
    left: 0%;
    width: 100%;
    z-index: 1000;
    padding: 1em;

    .confine {
      transition: all 500ms ease;
      padding: 1em;
      border-radius: 1em;
      max-width: 1440px;
      margin: 0 auto;
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;

      .btn-main {
        @media screen and (max-width: 1024px) {
          span {
            display: none;
          }
        }
      }
      .socials {
        display: flex;
        align-items: center;
        gap: 3em;
        @media screen and (max-width: 550px) {
          gap: 1em;
        }
        .btn-headicon {
          color: white;
          width: 30px;
          transition: all 500ms ease;
          height: 30px;
          svg {
            width: 100%;
            height: 100%;
          }
          filter: drop-shadow(0px 0px 5px rgb(135, 178, 226));
          @media screen and (max-width: 550px) {
            width: 25px;
            height: 25px;
          }
          @media screen and (max-width: 420px) {
            width: 20px;
            height: 20px;
          }
        }
      }
    }
    &.scrolled {
      .confine {
        background: rgba(231, 237, 247, 0.555);
        backdrop-filter: blur(10px);
        box-shadow: 0px 0px 15px 3px #133c6686;
        .socials {
          .btn-headicon {
            color: #012d5a;
            filter: drop-shadow(0px 0px 2px rgba(74, 79, 150, 0.432));
          }
        }
      }
    }
  }
</style>
