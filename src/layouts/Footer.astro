---
import { Icon } from "astro-icon/components";
import Image from "astro/components/Image.astro";
import footerart from "@/assets/g/footerart.png";
import footline from "@/assets/d/footheadline.png";
import iceart from "@/assets/b/iceart.png";
---

<footer
  id="footer"
  style={{
    "--bg": `url(${iceart.src})`,
  }}
>
  <div class="confine">
    <div class="l">
      <div class="footsect">
        <div class="foothead">
          <h2>NAVIGATE</h2>
          <Image src={footline} alt="" />
        </div>
        <nav class="footnav">
          <a href="#" class="btn btn-footnav">HOME</a>
          <a href="#stats" class="btn btn-footnav">STATS</a>
          <a href="#about" class="btn btn-footnav">ABOUT</a>
          <a
            href="https://uwumarket.us/collections/senz"
            target="_blank"
            class="btn btn-footnav">MERCH</a
          >
          <a href="#stream" class="btn btn-footnav">STREAMS</a>
          <a href="#contact" class="btn btn-footnav">CONTACT</a>
        </nav>
      </div>
      <div class="footsect">
        <div class="foothead">
          <h2>OTHER LINKS</h2>
          <Image alt={""} src={footline} />
        </div>
        <nav class="external">
          <a href="#" class="btn btn-footnav">Side Channel</a>
          <a href="#" class="btn btn-footnav">Reddit</a>
          <a href="#" class="btn btn-footnav">Throne</a>
          <a href="#" class="btn btn-footnav">VOD Channel</a>
          <a href="#" class="btn btn-footnav">Kick</a>
          <a href="#" class="btn btn-footnav">Patreon</a>
          <a href="#" class="btn btn-footnav">ASMR Channel</a>
          <a href="#" class="btn btn-footnav">Facebook</a>
          <a href="#" class="btn btn-footnav">Bluesky</a>
        </nav>
      </div>

      <div class="attrib">
        <h2 class="copy">Senz © 2026 All Rights Reserved.</h2>
        <a href="https://x.com/shubamium2" class="creds"
          >website design by SHUBAMIUM</a
        >
      </div>
    </div>
    <div class="r">
      <div class="top">
        <div class="important-link">
          <a href="https://www.youtube.com/@SenzVT" class="btn btn-link">
            <Icon name="mingcute:youtube-fill" class="icon" is:inline />
          </a>
          <a href="https://x.com/SenzVT" class="btn btn-link">
            <Icon name="mingcute:social-x-fill" class="icon" is:inline />
          </a>
          <a href="https://www.twitch.tv/senz" class="btn btn-link">
            <Icon name="mingcute:twitch-fill" class="icon" is:inline />
          </a>
          <a href="https://www.instagram.com/senz.vt/#" class="btn btn-link">
            <Icon name="mingcute:instagram-fill" class="icon" is:inline />
          </a>
        </div>
        <div class="scroll-top">
          <a href="#" class="btn btn-scroll">
            <Icon name="mdi:arrow-top-left-bold-box" class="icon" is:inline />
            SCROLL TO TOP
          </a>
        </div>
      </div>
      <div class="bottom">
        <Image alt={""} src={footerart} />
      </div>
    </div>
  </div>
</footer>

<style lang="scss">
  #footer {
    overflow: hidden;
    background: var(--bg), linear-gradient(to bottom, #27498d, #215bcf);
    background-size: 230%;
    background-position: center top;
    background-repeat: no-repeat;
    background-blend-mode: multiply;
    // clip-path: polygon(0% 0%, 61% 4%, 61% 11%, 64% 5%, 100% 0%, 100% 100%, 0% 100%);
    clip-path: polygon(
      0% 0%,
      61% 4%,
      61% 11%,
      63% 4%,
      100% 0%,
      100% 100%,
      0% 100%,
      0 100%,
      0 24%
    );
    @media screen and (max-width: 1024px) {
      clip-path: polygon(
        0% 0%,
        0% 100%,
        100% 100%,
        100% 0%,
        75% 0%,
        72% 2%,
        71% 0%
      );
    }
    .confine {
      display: flex;
      justify-content: space-between;
      max-width: 1920px;
      margin: 0 auto;
      padding-left: 2em;
      @media screen and (max-width: 440px) {
        padding-left: 0.2em;
      }
      @media screen and (max-width: 1024px) {
        display: flex;
        flex-direction: column;
        max-width: 90%;
      }
      @media screen and (max-width: 1280px) {
      }
      .l {
        padding-top: 50px;
      }
      .footsect {
        margin: 4em 0;
        .foothead {
          display: flex;
          gap: 1em;
          h2 {
            font-size: 2.5rem;
            align-items: center;
            font-weight: bold;
            font-family: var(--fontH);
          }
          @media screen and (max-width: 768px) {
            h2 {
              font-size: 1.5rem;
            }
            img {
              max-width: 150px;
              object-fit: contain;
            }
          }
        }

        .footnav {
          display: grid;
          grid-template-columns: 1fr 1fr;

          .btn-footnav {
            color: white;
            text-transform: uppercase;
            font-family: var(--fontH);
            text-decoration: none;
            font-size: 2rem;
            font-weight: 300;
            @media screen and (max-width: 768px) {
              font-size: 1.4rem;
            }
          }
        }
        .external {
          display: grid;
          grid-template-columns: 1fr 1fr 1fr;
          gap: 0.5em;
          @media screen and (max-width: 1550px) {
            grid-template-columns: 1fr 1fr;
          }
          margin: 1em 0;
          .btn-footnav {
            background: white;
            text-decoration: none;
            color: #0360c0;
            padding: 0.5em 1em;
            border-radius: 0.25em;
            text-align: right;
            box-shadow: 0px 2px 4px rgba(0, 0, 0, 0.438);
          }
        }
      }

      .attrib {
        color: white;

        .copy {
          font-family: var(--fontH);
        }
        .creds {
          font-weight: bold;
          color: white;
          text-decoration: none;
          font-weight: 200;
        }
      }

      .r {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        .top {
          padding-right: 2em;
          margin-top: 50px;
          .important-link {
            display: flex;
            gap: 2.5em;
            padding: 0.5em 2em;
            border-radius: 1em;
            border: 1px solid white;
            padding-bottom: 0;
            .btn-link {
              font-size: 2rem;
              color: white;
            }
          }
          .scroll-top {
            color: white;
            display: flex;
            justify-content: flex-end;
            .btn-scroll {
              font-size: 1.4rem;
              color: white;
              margin: 1em 0;
              display: flex;
              align-items: center;
              gap: 1em;
              font-family: var(--fontH);
              font-weight: bold;
              text-decoration: none;
              border-bottom: 2px solid white;
            }
          }
        }
        .bottom {
          @media screen and (max-width: 768px) {
            height: 420px;
          }
          @media screen and (max-width: 420px) {
            height: 350px;
          }
          img {
            max-width: 100%;
            object-fit: cover;
            @media screen and (max-width: 768px) {
              width: auto;
              height: 500px;
              max-width: initial;
              left: 0%;
              position: absolute;
            }
            @media screen and (max-width: 550px) {
              height: 400px;
            }
            @media screen and (max-width: 420px) {
              height: 350px;
            }
          }
        }
      }
    }
  }
</style>
