---
import "@/styles/global.scss";
import bgImage from "@/assets/b/iceart.png";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import Loading from "@/components/loading/Loading";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <style>
      @import url("https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap");
    </style>

    <!-- Primary Meta Tags -->
    <title>Senz VTuber ✧ Official Site</title>
    <meta name="title" content="Senz VTuber ✧ Official Site" />
    <meta
      name="description"
      content="Official website of Senz VTuber. Check out his live streams, social links, contact info, website statistics, reference sheets, and VA demos, as well as contact information! Welcome Snowmies!"
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="http://senz.to/" />
    <meta property="og:title" content="Senz VTuber ✧ Official Site" />
    <meta
      property="og:description"
      content="Official website of Senz VTuber. Check out his live streams, social links, contact info, website statistics, reference sheets, and VA demos, as well as contact information! Welcome Snowmies!"
    />
    <meta
      property="og:image"
      content="https://shubastore.venmiart.com/api/public/dl/rQRL0-Sl?inline=true"
    />

    <!-- X (Twitter) -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="http://senz.to/" />
    <meta property="twitter:title" content="Senz VTuber ✧ Official Site" />
    <meta
      property="twitter:description"
      content="Official website of Senz VTuber. Check out his live streams, social links, contact info, website statistics, reference sheets, and VA demos, as well as contact information! Welcome Snowmies!"
    />
    <meta
      property="twitter:image"
      content="https://shubastore.venmiart.com/api/public/dl/rQRL0-Sl?inline=true"
    />

    <!-- Meta Tags Generated with https://metatags.io -->
  </head>
  <body style={`--bg:url(${bgImage.src})`}>
    <div class="side-line">
      <div class="l">
        <img src="/starline.svg" alt="" class="top" />
        <img src="/starline.svg" alt="" class="bottom" />
      </div>
      <div class="r">
        <img src="/starline.svg" alt="" class="top" />
        <img src="/starline.svg" alt="" class="bottom" />
      </div>
    </div>
  </body>
  <!-- <Loading client:load /> -->
  <Header />
  <slot />
  <Footer />
</html>

<style lang="scss" is:global>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }

  body:has(#loading) {
    main {
      opacity: 0;
    }
  }
  html,
  body,
  main {
    max-width: 100vw;
    overflow-x: clip;
    position: relative;
  }
  main {
    overflow: hidden;
    transition: opacity 1500ms ease;
    z-index: 10;
  }

  :root {
    scroll-behavior: smooth;
  }
</style>
