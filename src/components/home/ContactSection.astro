---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import contactgif from "@/assets/g/contact.gif";
---

<section id="contact">
  <div class="confine">
    <div class="panel">
      <form class="form">
        <div class="linehead white">
          <div class="line"></div>
          <p>04 CONTACT</p>
          <hr />
        </div>
        <div class="heading">
          <h2>LET’S WORK <span>❆</span> <br /> TOGETHER</h2>
        </div>
        <div class="fg">
          <div class="input">
            <label for="name">Name</label>
            <input
              type="text"
              name="name"
              id="name"
              placeholder="Write your name here!"
            />
          </div>
          <div class="input">
            <label for="email">Email</label>
            <input
              type="email"
              name="email"
              id="email"
              placeholder="Write your email here!"
            />
          </div>
        </div>
        <div class="input">
          <label for="message">Message</label>
          <textarea
            name="message"
            id="message"
            placeholder="Write your message here!"></textarea>
        </div>
        <div class="action">
          <div class="mail">
            <Icon name={"mingcute:mail-fill"} />
            <p>senzvtuber@gmail.com</p>
          </div>
          <button class="btn btn-main" type="submit">
            <Icon name={"tabler:snowflake"} class={"icon"} is:inline />
            Submit
          </button>
        </div>
      </form>
      <div class="art">
        <Image alt={""} src={contactgif} class={"sideart"} />
      </div>
    </div>
  </div>
</section>
<div class="contact-zigz"></div>
<div class="contact-pop success">
  <div class="panel">
    <img src="/loading/3.gif" alt="" class="gif" />
    <h2>Message sent successfully!</h2>
    <p>Thank you for reaching out. I'll get back to you as soon as possible.</p>
  </div>
</div>
<div class="contact-pop fail">
  <div class="panel">
    <img src="/loading/2.gif" alt="" class="gif" />
    <h2>Something went wrong!</h2>
    <p>
      Sorry, there was an error sending your message. Please try again later.
    </p>
  </div>
</div>
<script>
  import { inView, animate } from "motion";
  // Contact section
  inView(
    "#contact",
    () => {
      animate(
        "#contact .art",
        { opacity: [0, 1], x: [-100, 0] },
        { duration: 2, type: "spring" },
      );

      animate(
        "#contact .form",
        { clipPath: ["inset(0% 100% 0% 0%)", "inset(0% 0% 0% 0%)"] },
        { duration: 0.8, delay: 0.5, ease: "easeInOut" },
      );
    },
    { amount: 0.5 },
  );

  const form = document.querySelector("#contact form");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target as HTMLFormElement);
    console.log(formData);
    submitForm(formData, form as HTMLFormElement);
  });

  async function submitForm(formData: FormData, form?: HTMLFormElement) {
    const showSuccessPopup = () => {
      const successPopup = document.querySelector(".contact-pop.success");
      successPopup?.classList.add("active");

      setTimeout(() => {
        successPopup?.addEventListener("click", () => {
          successPopup?.classList.remove("active");
        });
      }, 1500);
    };

    const showFailPopup = () => {
      const failPopup = document.querySelector(".contact-pop.fail");
      failPopup?.classList.add("active");

      setTimeout(() => {
        failPopup?.addEventListener("click", () => {
          failPopup?.classList.remove("active");
        });
      }, 1500);
    };
    try {
      const apikey = import.meta.env.PUBLIC_MAILY_API_KEY;
      console.log("API Key:", apikey); // Debugging line to check if the API key is loaded
      const html = `
			<div style="font-family: Arial, sans-serif; line-height: 1.5; color: #111;">
				<h2>New Contact Form Submission</h2>

				<p>Hey, someone contacted you through the Senz.to website.</p>

				<p>Here’s what they submitted:</p>

				<hr />

				<p><strong>Name:</strong> ${formData.get("name")}</p>
				<p><strong>Email:</strong> ${formData.get("email")}</p>
				<p><strong>Message:</strong></p>
				<p>${formData.get("message")}</p>

				<hr />

				<p style="font-size: 12px; color: #666;">
					This message was sent from the Senz.to contact form. Reply to the email address provided to get back to them!
					DO NOT REPLY TO THIS EMAIL ADDRESS as it is not monitored.
				</p>
			</div>
		`;
      const mailPayload = {
        from: "Senz.to Website <shubamium@venmiart.com>",
        to: import.meta.env.PUBLIC_CONTACT_RECEIVER_EMAIL,
        subject: `Senz.to - Contact Form Submission from ${formData.get("name")}`,
        html: html,
      };
      const response = await fetch("https://maily.id/api/v1/emails/send", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-API-Key": `${import.meta.env.PUBLIC_MAILY_API_KEY}`,
        },
        body: JSON.stringify(mailPayload),
      });
      if (response.ok) {
        showSuccessPopup();
        form?.reset();
      } else {
        showFailPopup();
      }
    } catch (error) {
      showFailPopup();
      console.error("Error submitting form:", error);
      alert("An error occurred while sending your message.");
    }
  }
  document.addEventListener("scroll", () => {
    animate(
      ".contact-zigz",
      { backgroundPositionX: `-${window.scrollY * 0.4}px` },
      { duration: 0.5, ease: "linear" },
    );
  });
</script>
<style lang="scss">
  .contact-pop {
    position: fixed;
    top: 0%;
    left: 0%;
    background: rgba(0, 0, 0, 0.811);
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    gap: 1em;

    z-index: 1100;

    opacity: 0;
    pointer-events: none;
    user-select: none;

    &.active {
      opacity: 1;
      pointer-events: initial;
      user-select: initial;
    }
    transition: all 1500ms ease;
    .gif {
      width: 150px;
      height: 150px;
    }
    .panel {
      display: flex;
      justify-content: center;
      align-items: center;
      flex-direction: column;
      z-index: 1400;
    }
  }
  .contact-zigz {
    position: relative;
    top: 0;
    left: 0;
    width: 100%;
    height: 80px;
    background-image: url("/zigs-v.png");
    background-repeat: repeat-x;
    background-size: 600px;
    z-index: -1;
  }
  #contact {
    position: relative;
    &::before {
      content: "";
      position: absolute;
      top: -100px;
      left: 0%;
      width: 100%;
      height: 55%;
      background: #cee6ff;
      scale: 0.98 1;
      transform-origin: top;
      z-index: -20;
      border-radius: 1em;
    }
    .confine {
      .panel {
        max-width: 90%;
        border-radius: 1em;
        background:
          url("/icetexture-4.png"), linear-gradient(to bottom, #6ebce0, #103694);
        margin: 100px auto;

        outline: 5px solid #344e82;
        outline-offset: 10px;

        display: grid;
        grid-template-columns: 1fr 1.5fr;
        @media screen and (max-width: 1024px) {
          display: flex;
          flex-direction: column;
        }
        .linehead {
          margin: 0.5em 0;
        }

        .form {
          padding-left: 2em;

          position: relative;
          padding-block: 2em;
          z-index: 100;
          height: 100%;
          @media screen and (max-width: 1024px) {
            padding: 1em;
          }
          .heading {
            font-size: 3rem;
            font-family: var(--fontH);
            line-height: 110%;
            margin: 0.5em 0;
            span {
            }

            @media screen and (max-width: 1024px) {
              font-size: 1.4rem;
            }
          }
          .fg {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1em;
            @media screen and (max-width: 550px) {
              grid-template-columns: 1fr;
              gap: 0em;
            }
          }
          .input {
            margin: 0.5em 0;
            background: #7396c7;
            border-radius: 0.4em;
            border: 1px solid white;
            padding: 0.5em 1em;

            display: flex;
            flex-direction: column;
            label {
              font-weight: bolder;
              color: white;
              font-family: var(--fontH);
              width: 100%;
            }
            input,
            textarea {
              background: none;
              font-family: var(--fontP);
              border: none;
              resize: none;
              color: white;
            }
            textarea {
              min-height: 150px;
            }
          }

          .action {
            display: flex;
            justify-content: space-between;
            @media screen and (max-width: 550px) {
              flex-wrap: wrap;
              align-items: center;
              justify-content: center;
            }
            .mail {
              display: flex;
              align-items: center;
              gap: 1em;
              @media screen and (max-width: 550px) {
                margin: 1em;
              }
              svg {
                width: 30px;
                height: 30px;
              }
              p {
                font-family: var(--fontH);
              }
            }
          }
        }
        .art {
          position: relative;

          @media screen and (max-width: 1024px) {
            height: 400px;
            .sideart {
              width: 100%;
            }
          }
          @media screen and (max-width: 550px) {
            height: 300px;
          }
          @media screen and (max-width: 420px) {
            height: 200px;
          }
          .sideart {
            height: auto;
            max-width: 1200px;
            mask-image: linear-gradient(to right, transparent 0%, white 50%);
            object-fit: cover;
            position: absolute;
            bottom: 0%;
            right: 0%;
          }
        }
      }
    }
  }
  #contact .art {
    opacity: 0;
    transform-origin: bottom;
  }
  #contact .form {
    clip-path: inset(0% 100% 0% 0%);
  }
</style>
