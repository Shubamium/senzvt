---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

import AboutA from '@/assets/g/about_a.png';
import AboutB from '@/assets/g/about_b.png';
---
<section id="about">

	<div class="confine">
			<div class="l">
				<div class="linehead">
					<div class="line"></div>
					<p>01 ABOUT</p>
					<hr>
				</div>

				<div class="heading">
					<h2 class="bio">Yo! I'm <span>Senz</span></h2>
					<p class="subtitle">(Placeholder) Welcome Snowmies! ❄️</p>
				</div>
				<p class="desc">Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod  tempor incididunt ut labore et dolore magna aliqua. </p>

				<div class="points">
					<div class="point">
						<p>Something Text</p>
					</div>
						<div class="point">
						<p>Something Text</p>
					</div>
						<div class="point">
						<p>Something Text</p>
					</div>
						<div class="point">
						<p>Something Text</p>
					</div>
				</div>

				<div class="contact-line">
					<a href="#" class="btn btn-contact">
						<Icon name='mingcute:spotify-fill' is:inline/>
					</a>
							<a href="#" class="btn btn-contact">
						<Icon name='mingcute:tiktok-fill' is:inline/>
					</a>
							<a href="#" class="btn btn-contact">
						<Icon name='mdi:youtube' is:inline/>
					</a>
							<a href="#" class="btn btn-contact">
						<Icon name='mingcute:twitch-fill' is:inline/>
					</a>
							<a href="#" class="btn btn-contact">
						<Icon name='mingcute:instagram-fill' is:inline/>
					</a>
							<a href="#" class="btn btn-contact">
						<Icon name='mingcute:social-x-fill' is:inline/>
					</a>
				</div>
				<div class="action">
					<button class="btn btn-outline" style={{'--btnColor':'#6E77FF'}}> 
						<Icon name='mdi:arrow-top-left-bold-box' class='icon' />
						Reference Sheets
					</button>
					<button class="btn btn-outline" style={{'--btnColor':'#5D8CE8'}}> 
						<Icon name='mdi:link-variant' class='icon'/>
						Links
					</button>
				</div>
			</div>
			<div class="r">
				<div class="abouta">
					<Image src={AboutA}  alt={''}/>
				</div>
				<div class="aboutb">
					<Image src={AboutB}  alt={''}/>

				</div>
			</div>

	</div>
</section>
<script>
	import { animate, inView } from 'motion';
	
	inView(
		'#about',()=>{
			const animateAll = async ()=>{
				await animate('#about',{
				opacity:[0,1],
				y:[150,0],
				
			},{
				duration:0.8
			})
			await animate(('#about .abouta'),{
				scale:[0.5,1],
				rotate:[0,20,-4],
				opacity:[0,1],
			},{
				duration:0.5,
				type:'spring',
			})
			animate(('#about .aboutb'),{
				scale:[0.6,1],
				rotate:[0,-20,4],
				opacity:[0,1],
			},{
				type:'spring',
				duration:1
			})
			}
			animateAll()
		}
	,{
		amount:0.5
	})
</script>
<style lang="scss">
	#about{
		opacity: 0;
		.confine{
			display: grid;
			grid-template-columns: 1fr 1fr;
			max-width: 1440px;
			margin:  0 auto;
			height: 800px;
			
			align-items:  center;
			@media screen and (min-width: 1024px) {
				margin-top: -200px;
				
			}
			
			.l{
				color: #5D86AF;

				.heading{
					margin: 1em 0;
					.bio{
						font-size: 5rem;
						color: #012D5A;
						line-height: 0.8;
						span{
							background: linear-gradient(to left, #5D8CE8,#0360C0);
							color: transparent;
							background-clip: text;
						}
					}
					.subtitle{
						font-size: 1.6rem;
						color: #012D5A;
						line-height: 0.9;
					}
				}
				.desc{
					margin-block: 1em;
				}
				.points{
					display: grid;
					grid-template-columns: 1fr 1fr;
					gap: .5em;
					max-width: 80%;
					margin-block: 1em;
					.point{
						color: #012D5A;
						background: #CED1FF;
						padding: .45em 1em;
						border-radius: 1em;
						p{
							font-size: 1.1rem;
						}
					}
				}

				.contact-line{
					display: flex;
					gap: 2em;
					margin-block: 2em;
					.btn-contact{
						width: 50px;
						height: 40px;
						padding: .4em;
						border-radius: .4em;
						&:hover{
							outline: 2px solid #012D5A;
						}
						color: #012D5A;
						svg{
							width: 100%;
							height: 100%;
						}
					}
				}

				.action{
					display: flex;
					gap: 1em;

			
				}
				
			}
			.r{
				position: relative;
				height: 100%;
				width: 100%;
				.abouta,.aboutb{
					position: absolute;
					height: 100%;
					z-index: 1;
					width: auto;
					scale:0.8;
					opacity: 0;
					border:20px solid white;
					box-shadow: 0px 0px 35px 15px #1888ff2d;
					&::before{
						content:'';
						position:absolute;
						top:0%;
						left:0%;
						width:100%;
						height:100%;
						// background: black;
					box-shadow:  inset 0px 0px 30px 10px #012e5a74 ;

					}
					img{
						height: 100%;
						width: auto;
					}
				}
				.abouta{
					rotate: -10deg;

				}
				.aboutb{
					bottom: -20%;
					scale: 0.6;
					right: -30%;
					rotate: 5deg;
				}
				
			}
		}
	}
</style>