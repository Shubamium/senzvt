---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

import AboutA from "@/assets/g/about_a.png";
import AboutB from "@/assets/g/about_b.png";
import refsheet from "@/assets/g/refsheet.jpg";
import icel from "@/assets/d/about_icel.png";
import icer from "@/assets/d/about_icer.png";
---

<section id="about">
  <div class="confine">
    <div class="l">
      <div class="linehead">
        <div class="line"></div>
        <p>01 ABOUT ME</p>
        <hr />
      </div>

      <div class="heading">
        <h2 class="bio">
          I'm <span class="name">Senz</span>
          <span class="emoji">❄️💙</span>
        </h2>
        <p class="subtitle">Welcome to my page!</p>
      </div>
      <p class="desc">
        I’m a frost themed VTuber and full time content creator for over 7 years
        with a passion for technology, horror, variety gaming, humor, singing,
        voice acting, and community!
      </p>

      <div class="points">
        <div class="point">
          <p>Content Creator/VTuber</p>
        </div>
        <div class="point">
          <p>Variety Streamer</p>
        </div>
        <div class="point">
          <p>Voice Actor</p>
        </div>
        <div class="point">
          <p>Gamer</p>
        </div>
      </div>

      <div class="contact-line">
        <a
          href="https://open.spotify.com/artist/0Sj6zkQKnuqE4T8N9b2Rb6"
          class="btn btn-contact"
        >
          <Icon name="mingcute:spotify-fill" is:inline />
        </a>
        <a href="https://www.tiktok.com/@senzvt" class="btn btn-contact">
          <Icon name="mingcute:tiktok-fill" is:inline />
        </a>
        <a href="https://www.youtube.com/@SenzVT" class="btn btn-contact">
          <Icon name="mdi:youtube" is:inline />
        </a>
        <a href="https://www.twitch.tv/senz" class="btn btn-contact">
          <Icon name="mingcute:twitch-fill" is:inline />
        </a>
        <a href="https://www.instagram.com/senz.vt" class="btn btn-contact">
          <Icon name="mingcute:instagram-fill" is:inline />
        </a>
        <a href="https://x.com/SenzVT" class="btn btn-contact">
          <Icon name="mingcute:social-x-fill" is:inline />
        </a>
      </div>
      <div class="action">
        <button
          class="btn btn-outline refsheet-toggle"
          style={{ "--btnColor": "#6E77FF" }}
        >
          <Icon name="mdi:arrow-top-left-bold-box" class="icon" is:inline />
          Reference Sheets
        </button>
        <button
          class="btn btn-outline links-toggle"
          style={{ "--btnColor": "#5D8CE8" }}
        >
          <Icon name="mdi:link-variant" class="icon" is:inline />
          Links
        </button>
        <button
          class="btn btn-outline vademo-toggle"
          style={{ "--btnColor": "#344E82" }}
        >
          <Icon name="mdi:microphone" class="icon" is:inline />
          VA Demo
        </button>
      </div>
    </div>
    <div class="r">
      <div class="abouta">
        <Image src={AboutA} alt={""} />
      </div>
      <div class="aboutb">
        <Image src={AboutB} alt={""} />
      </div>
    </div>
  </div>
  <Image src={icel} alt="" class={"icel"} />
  <Image src={icer} alt="" class={"icer"} />
</section>
<div class="refsheet-popup">
  <Image src={refsheet} alt="" />
</div>
<div class="links-popup">
  <div class="links">
    <h2 class="heading">
      <Icon name="mdi:link-variant" class="icon" is:inline />
      LINKS
    </h2>
    <div class="collection">
      <a href="https://www.tiktok.com/@senzvt" class="btn btn-contact">
        Tiktok
      </a>
      <a href="https://www.youtube.com/@SenzVT" class="btn btn-contact">
        Youtube</a
      >
      <a href="https://www.twitch.tv/senz" class="btn btn-contact"> Twitch </a>
      <a href="https://www.instagram.com/senz.vt" class="btn btn-contact">
        Instagram
      </a>
      <a href="https://x.com/SenzVT" class="btn btn-contact"> Spotify </a>
      <a href="https://x.com/SenzVT" class="btn btn-contact">X / Twitter</a>
      <a href="#" class="btn btn-contact">Side Channel</a>
      <a href="#" class="btn btn-contact">Reddit</a>
      <a href="#" class="btn btn-contact">Throne</a>
      <a href="#" class="btn btn-contact">VOD Channel</a>
      <a href="#" class="btn btn-contact">Kick</a>
      <a href="#" class="btn btn-contact">Patreon</a>
      <a href="#" class="btn btn-contact">ASMR Channel</a>
      <a href="#" class="btn btn-contact">Facebook</a>
      <a href="#" class="btn btn-contact">Bluesky</a>
    </div>
  </div>
</div>
<div class="vademo-popup">
  <div class="panel">
    <h2 class="heading">
      <Icon name="mdi:microphone" class="icon" is:inline />
      VA DEMO
    </h2>
    <div class="audiolist">
      <div class="audio">
        <h2>AUDIO #1</h2>
        <audio
          src="https://diviextended.com/wp-content/uploads/2021/10/sound-of-waves-marine-drive-mumbai.mp3"
          controls></audio>
      </div>
    </div>
  </div>
</div>

<script>
  import { animate, inView } from "motion";

  inView(
    "#about",
    () => {
      const animateAll = async () => {
        await animate(
          "#about",
          {
            opacity: [0, 1],
            y: [150, 0],
          },
          {
            duration: 0.8,
          },
        );
        await animate(
          "#about .abouta",
          {
            scale: [0.5, 1],
            rotate: [0, 20, -4],
            opacity: [0, 1],
          },
          {
            duration: 0.5,
            type: "spring",
          },
        );
        animate(
          "#about .aboutb",
          {
            scale: [0.6, 1],
            rotate: [0, -20, 4],
            opacity: [0, 1],
          },
          {
            type: "spring",
            duration: 1,
          },
        );
      };
      animateAll();
    },
    {
      amount: 0.5,
    },
  );

  function handleRefsheetPopup() {
    const btn = document.querySelector(".refsheet-toggle");
    const popup = document.querySelector(".refsheet-popup");
    btn?.addEventListener("click", () => {
      popup?.classList.add("active");
    });
    popup?.addEventListener("click", () => {
      popup?.classList.remove("active");
    });
  }
  handleRefsheetPopup();

  function handleLinksPopup() {
    const btn = document.querySelector(".links-toggle");
    const popup = document.querySelector(".links-popup");
    btn?.addEventListener("click", () => {
      popup?.classList.add("active");
    });
    popup?.addEventListener("click", () => {
      popup?.classList.remove("active");
    });
  }
  handleLinksPopup();

  function handleVademoPopup() {
    const btn = document.querySelector(".vademo-toggle");
    const popup = document.querySelector(".vademo-popup");
    const audio = document.querySelector(
      ".vademo-popup audio",
    ) as HTMLAudioElement;
    btn?.addEventListener("click", () => {
      popup?.classList.add("active");
    });
    popup?.addEventListener("click", () => {
      popup?.classList.remove("active");
      audio?.pause();
    });
  }
  handleVademoPopup();
</script>
<style lang="scss">
  .refsheet-popup {
    position: fixed;
    top: 0%;
    left: 0%;
    background: rgba(0, 0, 0, 0.752);
    width: 100vw;
    height: 100vh;
    z-index: 1500;
    display: flex;
    align-items: center;
    justify-content: center;

    &.active {
      opacity: 1;
      pointer-events: initial;
      user-select: initial;
      img {
        transform: translateY(0px) rotate(0deg) scale(1);
      }
    }
    opacity: 0;
    pointer-events: none;
    user-select: none;
    transition: all 900ms cubic-bezier(0.075, 0.82, 0.165, 1);
    img {
      transition: all 1200ms cubic-bezier(0.075, 0.82, 0.165, 1);
      height: 90vh;
      max-width: 80vw;
      width: auto;
      transform: translateY(100px) rotate(-30deg) scale(0);
      object-fit: contain;
      box-shadow: 0px 0px 0px white;
    }
  }
  .links-popup {
    position: fixed;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.608);
    backdrop-filter: blur(10px);
    z-index: 1500;
    top: 0%;
    left: 0%;
    display: flex;
    align-items: center;
    justify-content: center;
    &.active {
      opacity: 1;
      pointer-events: initial;
      user-select: initial;
      .links {
        transform: translateY(0px) rotate(0deg) scale(1);
      }
    }
    opacity: 0;
    pointer-events: none;
    user-select: none;
    transition: all 900ms cubic-bezier(0.075, 0.82, 0.165, 1);
    .links {
      background: white;
      max-width: 50%;
      padding: 4em;
      border-radius: 1em;
      transform: translateY(100px) rotate(0deg) scale(1);
      transition: all 900ms ease;
      @media screen and (max-width: 1280px) {
        max-width: 80vw;
      }
      @media screen and (max-width: 550px) {
        padding: 2em;
      }
      @media screen and (max-width: 420px) {
        padding: 1em;
      }
      .heading {
        font-size: 3rem;
        color: #012d5a;
        font-family: var(--fontH);
        display: flex;
        padding-bottom: 0.25em;
        align-items: center;
        gap: 0.2em;
      }
      .collection {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 0.55em;
        @media screen and (max-width: 550px) {
          grid-template-columns: 1fr 1fr;
        }
        a {
          background: #5d8ce8;
          color: white;
          text-decoration: none;
          border-radius: 0.5em;
          text-align: center;
          padding: 0.25em 1em;
          font-weight: bold;
          font-size: 1.4rem;
          @media screen and (max-width: 768px) {
            font-size: 1.1rem;
          }
          &:hover {
            outline: 3px solid #012d5a;
          }
        }
      }
    }
  }
  .vademo-popup {
    position: fixed;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.608);
    backdrop-filter: blur(10px);
    z-index: 1500;
    top: 0%;
    left: 0%;
    display: flex;
    align-items: center;
    justify-content: center;
    &.active {
      opacity: 1;
      pointer-events: initial;
      user-select: initial;
      .panel {
        transform: translateY(0px) rotate(0deg) scale(1);
      }
    }
    opacity: 0;
    pointer-events: none;
    user-select: none;
    transition: all 900ms cubic-bezier(0.075, 0.82, 0.165, 1);
    .panel {
      background: white;
      max-width: 50%;
      padding: 4em;
      border-radius: 1em;
      transform: translateY(100px) rotate(0deg) scale(1);
      transition: all 900ms ease;
      @media screen and (max-width: 1280px) {
        max-width: 80vw;
      }
      @media screen and (max-width: 550px) {
        padding: 2em;
      }
      @media screen and (max-width: 420px) {
        padding: 1em;
      }
      .heading {
        font-size: 3rem;
        color: #012d5a;
        font-family: var(--fontH);
        display: flex;
        padding-bottom: 0.25em;
        align-items: center;
        gap: 0.2em;
        white-space: nowrap;
        @media screen and (max-width: 420px) {
          display: flex;
          flex-direction: column;
        }
      }
      .audiolist {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        .audio {
          background: #5d8ce8;
          padding: 1em;
          border-radius: 1em;
          h2 {
            fontffamily: var(--fontH);
            font-size: 2rem;
            padding-bottom: 1em;
            text-align: center;
          }
        }
      }
    }
  }
  #about {
    opacity: 0;
    position: relative;
    .confine {
      display: grid;
      grid-template-columns: 1fr 1fr;
      max-width: 1440px;
      margin: 0 auto;
      height: 800px;

      @media screen and (max-width: 1440px) {
        max-width: 90%;
      }

      align-items: center;
      @media screen and (max-width: 1024px) {
        height: auto;
        margin-top: -200px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
      }

      .linehead {
        padding-bottom: 1em;
      }
      .l {
        color: #5d86af;
        @media screen and (max-width: 1024px) {
          padding-top: 200px;
        }
        .heading {
          padding-bottom: 1em;
          margin: 1em 0;
          .bio {
            font-size: 5rem;
            color: #012d5a;
            line-height: 0.8;
            @media screen and (max-width: 768px) {
              font-size: 3rem;
            }
            .name {
              background: linear-gradient(to left, #5d8ce8, #0360c0);
              color: transparent;
              background-clip: text;
            }
            .emoji {
              font-size: 3rem;
            }
          }
          .subtitle {
            font-size: 1.8rem;
            color: #012d5a;
            line-height: 0.9;
            @media screen and (max-width: 768px) {
              font-size: 1rem;
            }
          }
        }
        .desc {
          margin-block: 1em;
          font-size: 1.2rem;
          @media screen and (max-width: 768px) {
            font-size: 1rem;
          }
        }
        .points {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 0.5em;
          max-width: 80%;
          margin-block: 1em;
          @media screen and (max-width: 768px) {
            max-width: 100%;
          }
          font-weight: bolder;
          .point {
            color: #012d5a;
            background: #ced1ff;
            padding: 0.45em 1em;
            border-radius: 1em;
            p {
              font-size: 1.1rem;
              @media screen and (max-width: 768px) {
                font-size: 0.8rem;
              }
            }
          }
        }

        .contact-line {
          display: flex;
          gap: 2em;
          margin-block: 2em;
          @media screen and (max-width: 768px) {
            gap: 0.5em;
          }
          .btn-contact {
            width: 50px;
            height: 40px;
            padding: 0.4em;
            border-radius: 0.4em;
            @media screen and (max-width: 768px) {
              width: 40px;
              height: 40px;
            }
            &:hover {
              outline: 2px solid #012d5a;
            }
            color: #012d5a;
            svg {
              width: 100%;
              height: 100%;
            }
          }
        }

        .action {
          display: flex;
          gap: 1em;
          @media screen and (max-width: 768px) {
            display: grid;
            grid-template-columns: 1fr 1fr;
          }
          .btn {
            @media screen and (max-width: 768px) {
              font-size: 1rem;
            }
            @media screen and (max-width: 420px) {
              display: flex;
              flex-direction: column;
              background: var(--btnColor);
              color: white;
            }
          }
        }
      }
      .r {
        position: relative;
        height: 100%;
        width: 100%;
        @media screen and (max-width: 1024px) {
          width: 100%;
          height: 700px;
          left: -50px;
          position: relative;
        }
        @media screen and (max-width: 550px) {
          height: 600px;
        }
        @media screen and (max-width: 420px) {
          height: 400px;
        }
        .abouta,
        .aboutb {
          position: absolute;
          height: 100%;
          z-index: 1;
          width: auto;
          scale: 0.8;
          opacity: 0;
          border: 20px solid white;
          box-shadow: 0px 0px 35px 15px #1888ff2d;
          @media screen and (max-width: 550px) {
            border-width: 10px;
          }
          &::before {
            content: "";
            position: absolute;
            top: 0%;
            left: 0%;
            width: 100%;
            height: 100%;
            // background: black;
            box-shadow: inset 0px 0px 30px 10px #012e5a74;
          }
          img {
            height: 100%;
            width: auto;
          }
        }
        .abouta {
          rotate: -10deg;
        }
        .aboutb {
          bottom: -20%;
          scale: 0.6;
          right: -30%;
          rotate: 5deg;
          @media screen and (max-width: 1024px) {
            scale: 0.4;
            right: -200px;
          }
        }
      }
    }
    .icel {
      position: absolute;
      bottom: 0%;
      left: 0%;
      z-index: -1;
      @media screen and (max-width: 550px) {
        bottom: -50px;
      }
    }
    .icer {
      position: absolute;
      bottom: -5%;
      rotate: -4deg;
      right: 0%;
      z-index: -4;

      @media screen and (max-width: 550px) {
        display: none;
      }
    }
  }
</style>
