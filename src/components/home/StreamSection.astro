---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import streamart from "@/assets/g/streamart.png";
---

<section id="stream">
  <div class="confine">
    <div class="side-zigs"></div>
    <div class="stream">
      <div class="top">
        <div class="left">
          <div class="linehead">
            <div class="line"></div>
            <p>03 STREAM</p>
            <hr />
          </div>
          <div class="heading">
            <h2>● LIVESTREAM</h2>
          </div>
        </div>
        <div class="right">
          <a
            href="https://twitch.tv/senz"
            class="btn btn-outline"
            style={{ "--btnColor": "#6E77FF" }}
          >
            <Icon name={"mingcute:twitch-fill"} is:inline />
            <p>twitch.tv/senz</p>
          </a>
        </div>
      </div>
      <div class="content">
        <iframe
          class="streamframe"
          src="https://player.twitch.tv/?&channel=senz&parent=senz.to"
          allowfullscreen=""
          allow="encrypted-media *;"></iframe>
      </div>
    </div>
    <div class="art">
      <Image alt={""} src={streamart} class={"streamart"} />
    </div>
  </div>
</section>
<script>
  import { inView, animate } from "motion";

  inView(
    "#stream",
    () => {
      // Art first
      animate(
        "#stream .art",
        { opacity: [0, 1] },
        { duration: 1.1, ease: [0.76, 0, 0.24, 1] },
      );

      // Then the stream content
      animate(
        "#stream .stream",
        { clipPath: ["inset(0% 0% 100% 0%)", "inset(0% 0% 0% 0%)"] },
        { duration: 1.1, delay: 0.5, ease: [0.76, 0, 0.24, 1] },
      );
    },
    { amount: 0.4 },
  );

  document.addEventListener("scroll", () => {
    animate("#stream .side-zigs", {
      backgroundPositionY: `${window.scrollY * 0.5}px`,
    });
  });
</script>
<style lang="scss">
  #stream {
    position: relative;

    .side-zigs {
      position: absolute;
      top: 0%;
      left: 0%;
      width: 50px;
      height: 100%;
      background-image: url("/zigs.png");
      background-repeat: repeat-y;
      background-size: cover;
      z-index: -1;
      @media screen and (max-width: 768px) {
        width: 20px;
        background-size: contain;
      }
    }
    .confine {
      position: relative;
      display: grid;
      grid-template-columns: 1.2fr 1fr;

      @media screen and (max-width: 1440px) {
        grid-template-columns: 1.5fr 1fr;
      }
      @media screen and (max-width: 1024px) {
        display: flex;
        flex-direction: column;
        align-items: center;
      }
      .stream {
        padding-left: 100px;

        @media screen and (max-width: 1024px) {
          padding-left: 5%;
          width: 100%;
        }
        .top {
          display: flex;
          justify-content: space-between;
          align-items: flex-end;
          padding: 1em;
          padding-top: 3em;
          @media screen and (max-width: 768px) {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            padding-top: 100px;
          }
        }
        .heading {
          font-size: 2rem;
          color: #6e77ff;
          font-family: var(--fontH);
          .btn-outline {
            --btnColor: #6e77ff;
            text-decoration: none;
          }
          @media screen and (max-width: 550px) {
            font-size: 1.4rem;
          }
        }
        .content {
          margin: 1em;
          .streamframe {
            border: none;
            width: 100%;
            aspect-ratio: 16 / 9;
            height: auto;
            border: 3px solid #012d5a;
            box-shadow: 0px 0px 10px 10px rgb(221, 237, 255);
            border-radius: 1em;
          }
        }
      }

      .art {
        position: relative;
        width: 100%;
        user-select: none;
        pointer-events: none;
        height: 100%;
        .streamart {
          position: absolute;
          height: 100%;
          top: 0%;
          right: 0%;
          z-index: -1;
          object-fit: cover;
          @media screen and (max-width: 1600px) {
            right: -40%;
          }
          @media screen and (max-width: 1280px) {
            right: -60%;
          }
          @media screen and (max-width: 1280px) {
            right: -300px;
            mask-image: linear-gradient(to bottom, transparent, white 50%);
          }
        }
        @media screen and (max-width: 1024px) {
          height: 800px;
        }
        @media screen and (max-width: 768px) {
          height: 600px;
          margin-top: -200px;
        }
        @media screen and (max-width: 550px) {
          // height: 400px;
          margin-top: 0%;
          width: 100%;
          height: 300px;

          .streamart {
            object-fit: contain;
            object-position: bottom;
            width: 100%;
            height: auto;
            right: 0%;
            top: initial;
            bottom: 0%;
          }
        }
      }
    }
  }

  #stream .art {
    opacity: 0;
  }
  #stream .stream {
    clip-path: inset(0% 100% 0% 0%);
  }
</style>
